# Optional model extraction. The complete local-rules workflow needs no key.
# Use an explicitly selected OpenAI-compatible chat/completions endpoint.
BOLRELAY_MODEL_URL=
BOLRELAY_MODEL=
BOLRELAY_MODEL_API_KEY=
# Required to enable the model endpoint; entered by the operator per browser session.
BOLRELAY_ACCESS_TOKEN=
# Node production server only (default loopback).
HOST=127.0.0.1
PORT=3000
